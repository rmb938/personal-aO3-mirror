{
  "name": "ao3mirror-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "generate": "svelte-kit sync && orval --config orval.config.ts --quiet",
    "generate:check": "svelte-kit sync && orval --config orval.config.ts --quiet --outdated",
    "check": "svelte-kit sync && node scripts/clear-check-cache.js && svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "26.6.10",
    "@types/trusted-types": "2.0.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "orval": "8.49.0",
    "svelte": "5.59.2",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
